custom.rules/
alert tcp any any -> $HOME_NET 22 (
msg:"Possible SSH Brute Force";
flow:to_server;
sid:1000001;
rev:1;
)

icmp.rules/
alert icmp any any -> any any (
msg:"ICMP Echo Request Detected";
itype:8;
sid:1000002;
rev:1;
)

ssh.rules/
alert tcp any any -> $HOME_NET 22 (
msg:"SSH Connection Attempt";
flags:S;
sid:1000003;
rev:1;
)
